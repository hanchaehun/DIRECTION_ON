# 복사해서 .env로 저장하고 값을 채운다. .env는 제출 ZIP에 넣지 않는다.
SONIOX_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# 크레딧이 게이트웨이 형태로 제공되면 주소를 바꾼다
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# SONIOX_STT_URL=wss://stt-rt.soniox.com/transcribe-websocket

# 실제 모델 사용 (기본은 fake)
AGENT_STT_BACKEND=soniox
AGENT_LLM_BACKEND=openai
AGENT_TTS_BACKEND=gemini
